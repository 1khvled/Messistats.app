{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/en/data/:path*", "destination": "/data/:path*" },
    { "source": "/en/img/:path*", "destination": "/img/:path*" },
    { "source": "/en/fonts/:path*", "destination": "/fonts/:path*" },
    { "source": "/en/assets/:path*", "destination": "/assets/:path*" },
    { "source": "/en", "destination": "/" },
    { "source": "/en/", "destination": "/" },
    { "source": "/en/goalsbyyear", "destination": "/goalsbyyear" },
    { "source": "/en/goalsbyseason", "destination": "/goalsbyseason" },
    { "source": "/en/dashboard", "destination": "/dashboard" },
    { "source": "/en/timeline", "destination": "/timeline" },
    { "source": "/en/achievements", "destination": "/achievements" },
    { "source": "/en/birthday", "destination": "/birthday" },
    { "source": "/en/admin", "destination": "/admin" },
    { "source": "/en/admin/", "destination": "/admin" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/img/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/data/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    }
  ]
}
