{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:lang/birthday",
      "has": [{ "type": "query", "key": "date", "value": "(?<date>.+)" }],
      "destination": "/en/birthday/$date",
      "permanent": true
    },
    {
      "source": "/:lang",
      "has": [{ "type": "query", "key": "date", "value": "(?<date>.+)" }],
      "destination": "/en/birthday/$date",
      "permanent": true
    },
    {
      "source": "/:lang/birthday",
      "has": [
        { "type": "query", "key": "month", "value": "(?<month>.+)" },
        { "type": "query", "key": "day", "value": "(?<day>.+)" }
      ],
      "destination": "/en/birthday/$month-$day",
      "permanent": true
    },
    {
      "source": "/admin",
      "destination": "/en",
      "permanent": true
    },
    {
