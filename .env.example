# Admin auth — Vercel ENV (never Supabase, never committed)
# Set ONE of these in Vercel Dashboard → Settings → Environment Variables → Redeploy

# Recommended: hash (64 hex). Generate with: npm run admin:hash -- yourpassword
# Uses same salt as api/admin-auth.js (default: (dev-salt-removed))
ADMIN_PASSWORD_HASH=

# Alternative plaintext (works, but hash is preferred):
# ADMIN_PASSWORD=your-strong-passphrase

# Optional custom salt — if you change it, regenerate the hash with same salt
# ADMIN_SALT=(dev-salt-removed)

# Supabase (public anon key is already in src/admin.js; no secret needed for analytics)
