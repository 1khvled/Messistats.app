# Admin auth — Vercel ENV (never Supabase, never committed)
# Set these in Vercel Dashboard → Settings → Environment Variables → Redeploy.
# NEVER use VITE_ prefixed names for secrets — VITE_* is bundled into client JS.

# Required: password hash. Generate with: npm run admin:hash -- "your-strong-passphrase"
# Output looks like: scrypt$16384$8$1$<salt>$<hash> (legacy 64-hex sha256 also accepted)
ADMIN_PASSWORD_HASH=

# Required in production: random 32+ char secrets (generate 2 different ones).
# ADMIN_SALT is the legacy-hash salt + rate-limit/token pepper.
# ADMIN_SESSION_SECRET signs admin session tokens (falls back to ADMIN_SALT).
ADMIN_SALT=
ADMIN_SESSION_SECRET=

# Required for analytics + admin (server-only, never expose to client):
# Supabase project URL + SERVICE ROLE key (server proxy hides the anon key).
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Plaintext alternative (works, hash preferred). Do NOT commit a real value here.
# ADMIN_PASSWORD=

# Supabase anon key is never exposed in client bundles. Public analytics
# are ingested securely via the /api/track serverless proxy.
