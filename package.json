{
  "name": "messi-stats",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Messi career stats clone (ronaldostats.app structure) - static, free data only",
  "scripts": {
    "dev": "vite --port 5173 --host",
    "prebuild": "node scripts/prebuild-check.mjs",
    "build": "vite build && node scripts/copy-en.mjs",
    "preview": "vite preview --port 4173",
    "verify": "node scripts/verify.mjs && node scripts/source-watch.mjs && node scripts/smart-check.mjs --dry-run",
    "verify:smart": "node scripts/smart-check.mjs --dry-run",
    "verify:smart:write": "node scripts/smart-check.mjs --write",
    "verify:watch": "node scripts/source-watch.mjs",
    "pending": "node scripts/confirm-provisional.mjs --list",
    "triage": "node scripts/triage.mjs",
    "audit": "node scripts/dist-audit.cjs",
    "sync:daily": "python scripts/scrape-live-sync.py && node scripts/source-watch.mjs",
    "admin:hash": "node scripts/generate-admin-hash.mjs"
  },
  "devDependencies": {
    "vite": "^6.0.0"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0"
  }
}
