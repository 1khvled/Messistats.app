{
  "name": "messi-stats",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Messi career stats clone (ronaldostats.app structure) - static, free data only",
  "scripts": {
    "dev": "vite --port 5173 --host",
    "build": "vite build",
    "preview": "vite preview --port 4173",
    "verify": "node scripts/verify.mjs && node scripts/source-watch.mjs && node scripts/smart-check.mjs --dry-run",
    "verify:smart": "node scripts/smart-check.mjs --dry-run",
    "verify:smart:write": "node scripts/smart-check.mjs --write",
    "verify:watch": "node scripts/source-watch.mjs",
    "pending": "node scripts/confirm-provisional.mjs --list"
  },
  "devDependencies": {
    "vite": "^6.0.0"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "@vercel/blob": "^2.8.0"
  }
}
